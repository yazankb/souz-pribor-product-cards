# Скопируйте в .env и заполните. Файл .env в .gitignore и не попадает в репозиторий.

# Провайдер: openai (любой OpenAI-совместимый API) | anthropic
LLM_PROVIDER=openai

# Ключ API (можно вместо него задать OPENAI_API_KEY / ANTHROPIC_API_KEY)
LLM_API_KEY=

# Модель. По умолчанию: openai -> gpt-4o-mini, anthropic -> claude-opus-5-5
LLM_MODEL=

# Только для OpenAI-совместимых API. Примеры:
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (ключ не нужен)
LLM_BASE_URL=

# Необязательные параметры
LLM_TIMEOUT=60               # секунд на запрос
LLM_MAX_RETRIES=3            # повторы при 429/5xx/таймаутах
LLM_MAX_REPAIR_ATTEMPTS=2    # сколько раз просить модель исправить ответ после проверки
LLM_TEMPERATURE=0.3          # только для OpenAI-совместимых API; none — не передавать (для моделей вроде o-series/gpt-5)
LLM_JSON_MODE=true           # response_format=json_object; выключите, если сервер его не поддерживает
